# ---------------------------------------------------------------------------
# Miswak Club — environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical URLs, sitemap and referral links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (server-only; the service role key must never be public) -------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (provider-agnostic; "resend" or "log") ---------------------------
# "log" prints the email instead of sending, which is handy locally.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="Miswak Club <hello@miswakclub.com>"
EMAIL_REPLY_TO=

# --- Admin dashboard (/admin) -----------------------------------------------
# 12+ characters. The dashboard stays locked while this is empty.
ADMIN_PASSWORD=
# Optional independent signing secret for the admin session cookie.
ADMIN_SESSION_SECRET=

# --- Analytics (optional) ---------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Feature flags ----------------------------------------------------------
# Only enable the public counter once a real waitlist count exists.
NEXT_PUBLIC_SHOW_WAITLIST_COUNT=false
NEXT_PUBLIC_ENABLE_REFERRALS=true
NEXT_PUBLIC_COLLECT_PHONE=true
NEXT_PUBLIC_COLLECT_COUNTRY=true

# --- Public contact and social links (empty values are hidden in the UI) ----
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_WHATSAPP=
